   <notes><![CDATA[
   file name: maven-artifact-manager-2.2.1.jar
   ]]></notes>
   <packageUrl regex="true">^pkg:maven/org\.apache\.maven/maven\-artifact\-manager@.*$</packageUrl>
   <vulnerabilityName>CVE-2021-26291</vulnerabilityName>
</suppress>

