<FindBugsFilter
        xmlns="https://github.com/spotbugs/filter/3.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">

    <!--
    QUIC stateless reset tokens are derived by encrypting a single fixed-size block.
    ECB and integrity warnings are false positives for this one-block token derivation.
    -->
    <Match>
        <Class name="io.helidon.quic.QuicEndpoint"/>
        <Method name="makeToken"/>
        <Bug pattern="CIPHER_INTEGRITY,ECB_MODE"/>
    </Match>

    <!--
    RFC 9001 Section 5.4.3 requires AES-ECB over a single 16-byte ciphertext sample
    to derive the header protection mask. ECB does not protect packet or application
    data here, and repeated-block pattern leakage does not apply to this single-block
    operation. Sections 5.3 and 9.4 specify that packet protection authenticates the
    unprotected header as associated data.
    -->
    <Match>
        <Class name="io.helidon.quic.QuicAesPacketProtection"/>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="CIPHER_INTEGRITY,ECB_MODE"/>
    </Match>

    <!--
    RFC 9001 Section 5.3 uses ChaCha20-Poly1305 as the authenticated packet AEAD
    when that cipher suite is negotiated, while Section 5.4.4 requires raw ChaCha20
    over five zero bytes to derive the header protection mask. The packet AEAD
    authenticates the payload and unprotected header as associated data; raw
    ChaCha20 is used only for the mask. FindSecBugs reports both transformations as
    lacking integrity.
    -->
    <Match>
        <Class name="io.helidon.quic.QuicChaCha20PacketProtection"/>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="CIPHER_INTEGRITY"/>
    </Match>

    <!--
    RFC 9001 Section 5.3 requires the packet AEAD nonce to be the packet
    protection IV XOR the zero-padded full packet number. RFC 9000 Section 12.3
    requires packet numbers to increase and never be reused within a packet
    number space. A random IV would violate QUIC packet protection. FindSecBugs
    cannot recognize this protocol-defined deterministic, unique nonce derivation.
    -->
    <Match>
        <Class name="io.helidon.quic.QuicChaCha20PacketProtection"/>
        <Method name="encryptPacket"/>
        <Bug pattern="STATIC_IV"/>
    </Match>

    <!--
    LdapName parses the certificate's encoded X.500 subject locally to read its
    common name. No LDAP query, directory context, or network operation uses
    this name, so the constructor's LDAP injection warning is a false positive.
    -->
    <Match>
        <Class name="io.helidon.quic.QuicTlsEndpointIdentity"/>
        <Method name="commonName"/>
        <Bug pattern="LDAP_INJECTION"/>
    </Match>
</FindBugsFilter>
