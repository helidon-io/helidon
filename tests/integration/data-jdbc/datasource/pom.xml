<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.helidon.tests.integration.data.jdbc</groupId>
        <artifactId>helidon-tests-integration-data-jdbc-project</artifactId>
        <version>28.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>helidon-tests-integration-data-jdbc-datasource</artifactId>
    <name>Helidon Tests Integration Data JDBC Datasource</name>

    <dependencies>
        <dependency>
            <groupId>io.helidon.config</groupId>
            <artifactId>helidon-config</artifactId>
        </dependency>
        <dependency>
            <groupId>io.helidon.data.sql.datasource</groupId>
            <artifactId>helidon-data-sql-datasource</artifactId>
        </dependency>
        <dependency>
            <groupId>io.helidon.data.sql.datasource</groupId>
            <artifactId>helidon-data-sql-datasource-hikari</artifactId>
        </dependency>
        <dependency>
            <groupId>io.helidon.service</groupId>
            <artifactId>helidon-service-registry</artifactId>
        </dependency>
        <dependency>
            <groupId>io.helidon.tests.integration.data.jdbc</groupId>
            <artifactId>helidon-tests-integration-data-jdbc-common-fixtures-mysql</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.helidon.tests.integration.data.jdbc</groupId>
            <artifactId>helidon-tests-integration-data-jdbc-common-fixtures-oracle</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>io.helidon.data.jdbc</groupId>
                    <artifactId>helidon-data-jdbc</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>io.helidon.tests.integration.data.jdbc</groupId>
            <artifactId>helidon-tests-integration-data-jdbc-common-fixtures-pgsql</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc17-production</artifactId>
            <type>pom</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>jdbc</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.hamcrest</groupId>
            <artifactId>hamcrest</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>verify-datasource-isolation</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <exclude>io.helidon.data.jdbc:helidon-data-jdbc</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <failIfNoTests>true</failIfNoTests>
                </configuration>
                <executions>
                    <execution>
                        <id>datasource-classpath</id>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>datasource-module-path</id>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                        <configuration>
                            <useModulePath>true</useModulePath>
                            <reportsDirectory>${project.build.directory}/failsafe-reports-module-path</reportsDirectory>
                            <summaryFile>${project.build.directory}/failsafe-reports-module-path/failsafe-summary.xml</summaryFile>
                            <systemPropertyVariables>
                                <datasource.test.modular>true</datasource.test.modular>
                            </systemPropertyVariables>
                        </configuration>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <!-- Match Surefire so Failsafe can read the Java 27 module descriptor. -->
                        <groupId>org.ow2.asm</groupId>
                        <artifactId>asm</artifactId>
                        <version>${version.lib.asm}</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>
</project>
