Types: deb
# Snapshot metadata is authenticated both by HTTPS and the Debian archive keyring. The Docker build also verifies the
# exact signed InRelease files before installing any package, allowing this expired snapshot to remain reproducible.
URIs: https://snapshot.debian.org/archive/debian/20260715T000000Z/
Suites: bookworm bookworm-updates
Components: main
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg
Check-Valid-Until: no

Types: deb
URIs: https://snapshot.debian.org/archive/debian-security/20260715T000000Z/
Suites: bookworm-security
Components: main
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg
Check-Valid-Until: no
