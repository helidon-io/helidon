<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.helidon.service</groupId>
        <artifactId>helidon-service-project</artifactId>
        <version>28.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>helidon-service-gradle-plugin</artifactId>
    <name>Helidon Service Gradle Plugin</name>
    <!--
        Exception to development guidelines 4.1.2.1 and 9.1: Gradle loads this
        build-tool adapter on the classpath, so it has no JPMS descriptor.
        The Gradle API artifact bundles XML packages that conflict with java.xml
        when the generator's module graph is resolved. Application and generator
        modules retain their JPMS descriptors.
    -->
    <properties>
        <!-- Plugin discovery uses META-INF/gradle-plugins, not JPMS service declarations. -->
        <helidon.services.skip>true</helidon.services.skip>
        <spotbugs.exclude>etc/spotbugs/exclude.xml</spotbugs.exclude>
    </properties>
    <dependencies>
        <dependency>
            <groupId>io.helidon.common</groupId>
            <artifactId>helidon-common</artifactId>
        </dependency>
        <dependency>
            <groupId>io.helidon.service</groupId>
            <artifactId>helidon-service-application-codegen</artifactId>
        </dependency>
        <dependency>
            <groupId>io.helidon.codegen</groupId>
            <artifactId>helidon-codegen</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.gradleplugins</groupId>
            <artifactId>gradle-api</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>io.helidon.codegen</groupId>
                                    <artifactId>helidon-codegen-api-stability-enforcer</artifactId>
                                    <version>${helidon.version}</version>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>io.helidon.codegen</groupId>
                        <artifactId>helidon-codegen-api-stability-enforcer</artifactId>
                        <version>${helidon.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>
</project>
