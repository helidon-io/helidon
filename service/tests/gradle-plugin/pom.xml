<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.helidon.service.tests</groupId>
        <artifactId>helidon-service-tests-project</artifactId>
        <version>28.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>helidon-service-tests-gradle-plugin</artifactId>
    <name>Helidon Service Tests Gradle Plugin</name>
    <properties>
        <!-- Exercise repository URI quoting in every publication test. -->
        <published.plugin.repository.base>${project.build.directory}/it-repo/published-plugin's-repository</published.plugin.repository.base>
        <published.plugin.repository>${published.plugin.repository.base}</published.plugin.repository>
        <published.plugin.repository.prefix>installed</published.plugin.repository.prefix>
    </properties>
    <dependencies>
        <dependency>
            <groupId>io.helidon.service</groupId>
            <artifactId>helidon-service-registry</artifactId>
        </dependency>
        <dependency>
            <groupId>io.helidon.service</groupId>
            <artifactId>helidon-service-gradle-plugin</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.helidon.service</groupId>
            <artifactId>io.helidon.service.gradle.plugin</artifactId>
            <version>${project.version}</version>
            <type>pom</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.helidon.service</groupId>
            <artifactId>helidon-service-application-codegen</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.helidon.service</groupId>
            <artifactId>helidon-service-codegen</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.helidon.codegen</groupId>
            <artifactId>helidon-codegen-apt</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.helidon.config.metadata</groupId>
            <artifactId>helidon-config-metadata-codegen</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.helidon.config.metadata</groupId>
            <artifactId>helidon-config-metadata</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.gradleplugins</groupId>
            <artifactId>gradle-test-kit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.hamcrest</groupId>
            <artifactId>hamcrest-all</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>fixture-runtime-classpath</id>
                        <phase>generate-test-resources</phase>
                        <goals><goal>build-classpath</goal></goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <outputFile>${project.build.directory}/fixture-runtime-classpath.txt</outputFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>fixture-tool-classpath</id>
                        <phase>generate-test-resources</phase>
                        <goals><goal>build-classpath</goal></goals>
                        <configuration>
                            <includeScope>test</includeScope>
                            <outputFile>${project.build.directory}/fixture-tool-classpath.txt</outputFile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <fixture.classpaths>${project.build.directory}</fixture.classpaths>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-invoker-plugin</artifactId>
                <configuration>
                    <localRepositoryPath>${published.plugin.repository.base}</localRepositoryPath>
                    <scope>runtime</scope>
                    <extraArtifacts>
                        <extraArtifact>io.helidon.service:io.helidon.service.gradle.plugin:${project.version}:pom</extraArtifact>
                        <extraArtifact>io.helidon.service:helidon-service-gradle-plugin:${project.version}</extraArtifact>
                        <extraArtifact>io.helidon.service:helidon-service-application-codegen:${project.version}</extraArtifact>
                        <extraArtifact>io.helidon.service:helidon-service-codegen:${project.version}</extraArtifact>
                        <extraArtifact>io.helidon.codegen:helidon-codegen-apt:${project.version}</extraArtifact>
                        <!-- Gradle parses imported BOM metadata from Helidon's parent POMs even for
                             unused managed dependencies; Invoker does not stage these imports automatically. -->
                        <extraArtifact>com.google.protobuf:protobuf-bom:${version.lib.google-protobuf}:pom</extraArtifact>
                        <extraArtifact>io.grpc:grpc-bom:${version.lib.grpc}:pom</extraArtifact>
                        <extraArtifact>com.oracle.database.jdbc:ojdbc-bom:${version.lib.ojdbc}:pom</extraArtifact>
                        <extraArtifact>com.fasterxml.jackson:jackson-bom:${version.lib.jackson}:pom</extraArtifact>
                        <extraArtifact>io.opentelemetry:opentelemetry-bom:${version.lib.opentelemetry}:pom</extraArtifact>
                        <extraArtifact>io.prometheus:prometheus-metrics-bom:${version.lib.prometheus}:pom</extraArtifact>
                        <extraArtifact>org.apache.logging.log4j:log4j-bom:${version.lib.log4j}:pom</extraArtifact>
                        <extraArtifact>org.slf4j:slf4j-bom:${version.lib.slf4j}:pom</extraArtifact>
                        <extraArtifact>org.junit:junit-bom:${version.lib.junit}:pom</extraArtifact>
                        <extraArtifact>io.smallrye.common:smallrye-common-bom:${version.lib.smallrye.common}:pom</extraArtifact>
                    </extraArtifacts>
                </configuration>
                <executions>
                    <execution>
                        <id>published-plugin-repository</id>
                        <phase>pre-integration-test</phase>
                        <goals><goal>install</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <fixture.version>${project.version}</fixture.version>
                        <fixture.repository>${published.plugin.repository}</fixture.repository>
                        <fixture.directory>${project.build.directory}/gradle-it</fixture.directory>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!-- Invoker installs with the enclosing Maven session's repository layout. Expose its
             installed-artifact root to Gradle without changing that session or its repositories. -->
        <profile>
            <id>published-plugin-split-repository</id>
            <activation>
                <property>
                    <name>aether.enhancedLocalRepository.split</name>
                    <value>true</value>
                </property>
            </activation>
            <properties>
                <published.plugin.repository>${published.plugin.repository.base}/${published.plugin.repository.prefix}</published.plugin.repository>
            </properties>
        </profile>
        <profile>
            <id>published-plugin-repository-prefix</id>
            <activation>
                <property>
                    <name>aether.enhancedLocalRepository.localPrefix</name>
                </property>
            </activation>
            <properties>
                <published.plugin.repository.prefix>${aether.enhancedLocalRepository.localPrefix}</published.plugin.repository.prefix>
            </properties>
        </profile>
    </profiles>
</project>
