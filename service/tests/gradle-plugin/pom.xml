<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.helidon.service.tests</groupId>
        <artifactId>helidon-service-tests-project</artifactId>
        <version>28.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>helidon-service-tests-gradle-plugin</artifactId>
    <name>Helidon Service Tests Gradle Plugin</name>

    <properties>
        <it.repo.path>${project.build.directory}/it-repo</it.repo.path>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.helidon.service</groupId>
            <artifactId>helidon-service-registry</artifactId>
        </dependency>
        <dependency>
            <groupId>io.helidon.service</groupId>
            <artifactId>helidon-service-gradle-plugin</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.helidon.service</groupId>
            <artifactId>io.helidon.service.gradle.plugin</artifactId>
            <version>${project.version}</version>
            <type>pom</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.helidon.service</groupId>
            <artifactId>helidon-service-codegen</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.helidon.codegen</groupId>
            <artifactId>helidon-codegen-apt</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.helidon.config.metadata</groupId>
            <artifactId>helidon-config-metadata-codegen</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.helidon.config.metadata</groupId>
            <artifactId>helidon-config-metadata</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.gradleplugins</groupId>
            <artifactId>gradle-test-kit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.hamcrest</groupId>
            <artifactId>hamcrest-all</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-invoker-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>pre-integration-test</phase>
                        <goals>
                            <goal>install</goal>
                        </goals>
                        <configuration>
                            <localRepositoryPath>${project.build.directory}/it-repo</localRepositoryPath>
                            <scope>test</scope>
                            <extraArtifacts>
                                <extraArtifact>io.helidon.service:io.helidon.service.gradle.plugin:${project.version}:pom</extraArtifact>
                                <extraArtifact>io.helidon.service:helidon-service-gradle-plugin:${project.version}</extraArtifact>
                                <extraArtifact>io.helidon.service:helidon-service-codegen:${project.version}</extraArtifact>
                                <extraArtifact>io.helidon.codegen:helidon-codegen-apt:${project.version}</extraArtifact>
                                <!-- imported boms -->
                                <extraArtifact>com.google.protobuf:protobuf-bom:${version.lib.google-protobuf}:pom</extraArtifact>
                                <extraArtifact>io.grpc:grpc-bom:${version.lib.grpc}:pom</extraArtifact>
                                <extraArtifact>com.oracle.database.jdbc:ojdbc-bom:${version.lib.ojdbc}:pom</extraArtifact>
                                <extraArtifact>com.fasterxml.jackson:jackson-bom:${version.lib.jackson}:pom</extraArtifact>
                                <extraArtifact>io.opentelemetry:opentelemetry-bom:${version.lib.opentelemetry}:pom</extraArtifact>
                                <extraArtifact>io.prometheus:prometheus-metrics-bom:${version.lib.prometheus}:pom</extraArtifact>
                                <extraArtifact>org.apache.logging.log4j:log4j-bom:${version.lib.log4j}:pom</extraArtifact>
                                <extraArtifact>org.slf4j:slf4j-bom:${version.lib.slf4j}:pom</extraArtifact>
                                <extraArtifact>org.junit:junit-bom:${version.lib.junit}:pom</extraArtifact>
                                <extraArtifact>io.smallrye.common:smallrye-common-bom:${version.lib.smallrye.common}:pom</extraArtifact>
                            </extraArtifacts>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-gradle-fixtures</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/it/projects</outputDirectory>
                            <useDefaultDelimiters>false</useDefaultDelimiters>
                            <delimiters>
                                <delimiter>@</delimiter>
                            </delimiters>
                            <resources>
                                <resource>
                                    <directory>src/it/projects</directory>
                                    <filtering>true</filtering>
                                    <includes>
                                        <include>**/*.gradle</include>
                                    </includes>
                                </resource>
                                <resource>
                                    <directory>src/it/projects</directory>
                                    <filtering>false</filtering>
                                    <excludes>
                                        <exclude>**/*.gradle</exclude>
                                    </excludes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>split-it-repo</id>
            <activation>
                <property>
                    <name>aether.enhancedLocalRepository.split</name>
                    <value>true</value>
                </property>
            </activation>
            <properties>
                <it.repo.path>${project.build.directory}/it-repo/installed</it.repo.path>
            </properties>
        </profile>
        <profile>
            <id>prefixed-it-repo</id>
            <activation>
                <property>
                    <name>aether.enhancedLocalRepository.localPrefix</name>
                </property>
            </activation>
            <properties>
                <it.repo.path>${project.build.directory}/it-repo/${aether.enhancedLocalRepository.localPrefix}</it.repo.path>
            </properties>
        </profile>
    </profiles>
</project>
